rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /predefinedEmojis/{emojiId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleId == resource.data.circleId
        )
      );
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lookup minimo por codigo de invitacion — sin datos sensibles.
    match /circleInvites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/circles/$(resource.data.circleId)).data.creatorId;
    }

    match /circles/{circleId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.creatorId &&
        request.resource.data.members == [request.auth.uid];

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.creatorId;
    }

    match /circles/{circleId}/joinRequests/{requestUserId} {
      allow create: if request.auth != null && request.auth.uid == requestUserId;
      allow read: if request.auth != null && (
        request.auth.uid == requestUserId ||
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members
      );
      allow update, delete: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }

    // [FIX] {document=**} con cero segmentos matchea también circles/{circleId}
    // mismo — Firestore documenta este comportamiento del wildcard recursivo.
    // Eso hacía que cualquier miembro pudiera borrar el círculo (semántica OR
    // entre bloques que matchean la misma ruta), pese al `allow delete`
    // restringido al creador en L47-48. Exigir subcollection+docId excluye
    // al documento padre sin perder cobertura de las subcolecciones reales.
    match /circles/{circleId}/{subcollection}/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }

    match /circles/{circleId}/{subcollection}/{docId}/{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }
  }
}
