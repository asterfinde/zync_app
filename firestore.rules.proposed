rules_version = '2';

// PROPUESTA — Sem 9, hallazgo de seguridad "circles sin gate de membresía".
// NO es el archivo que se despliega (ver firebase.json → firestore.rules).
// Este archivo solo se usa para tests contra el Firebase Emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /predefinedEmojis/{emojiId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.circleId == resource.data.circleId
        )
      );
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lookup minimo por codigo de invitacion — sin datos sensibles.
    match /circleInvites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.uid == get(/databases/$(database)/documents/circles/$(resource.data.circleId)).data.creatorId;
    }

    match /circles/{circleId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.creatorId &&
        request.resource.data.members == [request.auth.uid];

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.creatorId;
    }

    match /circles/{circleId}/joinRequests/{requestUserId} {
      // create + update (no solo create): un usuario que salió del círculo y
      // vuelve a solicitar ingreso reusa el mismo doc (circle_service.dart
      // requestToJoinCircle "set sobreescribe") — para Firestore Rules ese
      // set() es un update si el doc ya existe de un ciclo anterior, no un
      // create. Se exige status == 'pending' para que el propio solicitante
      // nunca pueda auto-aprobarse; la aprobación real (status: 'approved')
      // sigue restringida a miembros en la regla de abajo.
      allow create, update: if request.auth != null && request.auth.uid == requestUserId &&
        request.resource.data.status == 'pending';
      allow read: if request.auth != null && (
        request.auth.uid == requestUserId ||
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members
      );
      allow update, delete: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }

    // [FIX] {document=**} con cero segmentos matchea también circles/{circleId}
    // mismo — Firestore documenta este comportamiento del wildcard recursivo.
    // Eso hacía que cualquier miembro pudiera borrar el círculo (semántica OR
    // entre bloques que matchean la misma ruta), pese al `allow delete`
    // restringido al creador en L47-48. Exigir subcollection+docId excluye
    // al documento padre sin perder cobertura de las subcolecciones reales.
    match /circles/{circleId}/{subcollection}/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }

    match /circles/{circleId}/{subcollection}/{docId}/{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }
  }
}
